{
  "name": "@kelid/server",
  "version": "0.1.0",
  "private": true,
  "description": "کلید — سرور (Fastify + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "esbuild src/main.ts src/admin/cli.ts --bundle --platform=node --format=esm --external:fastify --external:pg --sourcemap --outbase=src --outdir=dist",
    "start": "node --enable-source-maps dist/main.js",
    "license-keys": "node scripts/license-keys.mjs",
    "admin": "node scripts/admin.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2"
  }
}
