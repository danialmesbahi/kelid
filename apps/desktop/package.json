{
  "name": "@kelid/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "کلید — نسخهٔ ویندوز",
  "author": "Kelid",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:better-sqlite3-multiple-ciphers",
    "dev": "npm run build:main && concurrently -k \"npm run dev -w @kelid/web\" \"wait-on tcp:5173 && cross-env KELID_DEV_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:main",
    "dist": "electron-builder --win nsis --x64",
    "release": "node scripts/release.mjs",
    "update-keys": "node scripts/update-keys.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "ir.kelid.desktop",
    "productName": "کلید",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*",
          "!map/**"
        ]
      },
      {
        "from": "build/update.json",
        "to": "update.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "کلید",
      "artifactName": "Kelid-Setup-${version}.${ext}",
      "language": "1065"
    },
    "electronVersion": "44.5.1",
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.9"
  }
}
