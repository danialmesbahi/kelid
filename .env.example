# Copy to .env (git-ignored).
# Desktop dev only: URL Electron loads instead of the built web app (set by `npm run dev:desktop`).
# KELID_DEV_URL=http://localhost:5173

# --- Server (apps/server) ---
# `npm run dev:server` defaults to the local Postgres from `npm run db:up`; set these only to point elsewhere.
# Runtime role: must NOT be superuser or BYPASSRLS (the server refuses to start otherwise).
# DATABASE_URL=postgres://kelid_app:kelid_app@localhost:5433/kelid
# Owner role used only for migrations (defaults to DATABASE_URL).
# MIGRATION_DATABASE_URL=postgres://kelid_owner:kelid_owner@localhost:5433/kelid
# PORT=3000
# HOST=127.0.0.1            # 0.0.0.0 inside Docker
# LOG_LEVEL=info            # fatal | error | warn | info | debug | trace | silent
# TRUST_PROXY=false         # true behind nginx / the cloud's load balancer

# Server tests (`npx vitest run apps/server`); skipped when unset.
# KELID_TEST_DATABASE_URL=postgres://kelid_app:kelid_app@localhost:5433/kelid_test
# KELID_TEST_MIGRATION_DATABASE_URL=postgres://kelid_owner:kelid_owner@localhost:5433/kelid_test
