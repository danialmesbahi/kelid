# Copy to .env (git-ignored).
# Desktop dev only: URL Electron loads instead of the built web app (set by `npm run dev:desktop`).
# KELID_DEV_URL=http://localhost:5173
# Desktop releases only: Ed25519 key that signs updates (default ~/.kelid/update-private.pem; never commit it).
# KELID_UPDATE_PRIVATE_KEY_FILE=

# --- Web app and vendor panel (read from apps/web/.env, apps/admin/.env or the shell, not this file) ---
# Vendor panel (apps/admin): server it talks to; `demo` = fake data for previews.
# VITE_ADMIN_API_URL=http://localhost:3000
# Server the app logs in to (build time). Unset = no login, local-only like phase 1. `demo` = fake server for previews (code 123456).
# VITE_KELID_API_URL=http://localhost:3000
# Map (Neshan, https://platform.neshan.org). Unset = no map, forms work as before. `demo` = blank offline map for previews/tests.
# Web map key: restrict it to the app's domains in the Neshan panel. Service key: search + address of a point (reverse geocoding).
# VITE_NESHAN_MAP_KEY=
# VITE_NESHAN_API_KEY=
# Public key that checks the subscription license (from `npm run license-keys -w @kelid/server`). Required for a real server build;
# dev builds fall back to the development key that `npm run dev:server` signs with.
# VITE_KELID_LICENSE_KEY=

# --- Server (apps/server) ---
# `npm run dev:server` defaults to the local Postgres from `npm run db:up`; set these only to point elsewhere.
# Runtime role: must NOT be superuser or BYPASSRLS (the server refuses to start otherwise).
# DATABASE_URL=postgres://kelid_app:kelid_app@localhost:5433/kelid
# Owner role used only for migrations (defaults to DATABASE_URL).
# MIGRATION_DATABASE_URL=postgres://kelid_owner:kelid_owner@localhost:5433/kelid
# Signs login tokens and hashes SMS codes; 32+ random chars (`openssl rand -base64 48`). Dev picks a random one per run.
# JWT_SECRET=
# SMS: `console` (dev default, prints codes and also returns them to the app as `devCode` so previews work without SMS; refused when NODE_ENV=production) or `kavenegar`.
# SMS_PROVIDER=kavenegar
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=kelid-otp      # an approved verify/lookup template with one %token
# Origins allowed to call the API; `null` = the Windows app (file://). Dev default: localhost:5173, the vendor panel on 5174, and null.
# CORS_ORIGINS=https://app.kelid.ir,https://admin.kelid.ir,null
# Vendor panel accounts are made only from the command line (no sign-up route): `npm run admin -w @kelid/server -- add --phone 09xxxxxxxxx --name "…"`.
# Photo storage (any S3-compatible service: ArvanCloud, Liara, MinIO). Unset = photo bytes stay in Postgres (fine for dev).
# All four of endpoint/bucket/keys or none; https only in production. The bucket must be PRIVATE: the server proxies every read.
# S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
# S3_REGION=ir-thr-at1
# S3_BUCKET=kelid-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Subscription license: Ed25519 key that signs each office's license (`npm run license-keys -w @kelid/server` prints a pair).
# Dev uses a built-in development key; production refuses to start without its own.
# LICENSE_PRIVATE_KEY=
# Payments: `dev` (default outside production: a fake gateway page on this server, every payment succeeds) or `zarinpal`.
# Unset in production = payments off (subscription status and licenses still work).
# PAYMENT_GATEWAY=zarinpal
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=false
# This server's public address; the gateway returns the user here (https in production). Dev default: http://localhost:PORT.
# PUBLIC_URL=https://api.kelid.ir
# PORT=3000
# HOST=127.0.0.1            # 0.0.0.0 inside Docker
# LOG_LEVEL=info            # fatal | error | warn | info | debug | trace | silent
# TRUST_PROXY=false         # true behind nginx / the cloud's load balancer

# Server tests (`npx vitest run apps/server`); skipped when unset.
# KELID_TEST_DATABASE_URL=postgres://kelid_app:kelid_app@localhost:5433/kelid_test
# KELID_TEST_MIGRATION_DATABASE_URL=postgres://kelid_owner:kelid_owner@localhost:5433/kelid_test
