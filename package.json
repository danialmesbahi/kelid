{
  "name": "kelid",
  "private": true,
  "version": "0.1.0",
  "description": "کلید — سامانهٔ فایل املاک (ویندوز، وب، موبایل)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev -w @kelid/web",
    "dev:desktop": "npm run dev -w @kelid/desktop",
    "dev:server": "npm run dev -w @kelid/server",
    "dev:admin": "npm run dev -w @kelid/admin",
    "dev:site": "npm run dev -w @kelid/site",
    "db:up": "docker compose -f apps/server/compose.yaml up -d",
    "build": "npm run build -w @kelid/web && npm run build -w @kelid/desktop",
    "dist:win": "npm run build && npm run dist -w @kelid/desktop",
    "typecheck": "tsc -p packages/core && tsc -p apps/web && tsc -p apps/admin && tsc -p apps/desktop && tsc -p apps/server && tsc -p apps/site",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "icons": "electron scripts/icons.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true
  }
}
